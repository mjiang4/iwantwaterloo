{
  "name": "iwantwaterloo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "preview": "node scripts/preview.mjs",
    "test:preview": "node --experimental-strip-types --test tests/preview-admin.mjs",
    "preview:stage": "node scripts/preview-stage.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "format:check": "oxfmt --check",
    "test:browser": "npm run build && node tests/e2e/check.mjs && node tests/e2e/park.mjs && node tests/e2e/realism.mjs && node tests/e2e/participation.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.102.8",
    "3d-tiles-renderer": "0.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "4.18.0",
    "suncalc": "2.0.2",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "miniflare": "4.20260515.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.1",
    "ws": "8.21.0",
    "sharp": "0.35.4",
    "esbuild": "0.28.2"
  }
}
