# The supported local setup is: npm ci && npm run preview
# It generates .env.preview automatically; no account or production secrets are needed.
#
# Only for advanced use of npm run dev after local database provisioning:
RATE_LIMIT_SECRET=replace-with-a-random-local-development-value

# Optional production admin email. Configure these in Sites runtime settings.
# Never commit actual keys or set these as VITE_/NEXT_PUBLIC_ variables.
# RESEND_API_KEY=your-sending-only-key
# ADMIN_EMAIL_FROM=I Want Waterloo <admin@iwantwaterloo.com>
# ADMIN_ORIGIN=https://iwantwaterloo.com
